#!/bin/bash
export XDG_RUNTIME_DIR=/run/user/$(id -u)
export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
export LIBGL_ALWAYS_SOFTWARE=1
trap 'sudo poweroff' EXIT

sudo systemctl start bankusr-session.service
for _ in {1..30}; do
  pgrep -u "$(id -u)" -x core >/dev/null && break
  sleep 0.5
done

sleep 2

google-chrome --start-fullscreen --no-first-run --no-default-browser-check \
  --password-store=basic "${IBANK_URL:-https://www.bb.com.br}"
